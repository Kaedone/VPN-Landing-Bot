---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { siteConfig } from '../../config/site';
---

<Section id="verify" class="bg-gray-950/40">
  <div class="max-w-4xl mx-auto space-y-10">
    <div class="text-center space-y-4">
      <Badge variant="teal">Доказуемость вместо обещаний</Badge>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">
        Не верь на слово. <span class="text-teal-400">Проверь сам.</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg max-w-2xl mx-auto">
        Мы не просим слепо верить в нашу анонимность. После подключения конфига открой независимые сервисы проверки утечек и убедись в чистоте соединения.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <Card class="flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="text-teal-400 font-mono text-xs uppercase tracking-wider">Проверка IP и отпечатков</div>
          <h3 class="text-xl font-bold text-white">Iphey.com</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Показывает твой реальный IP, геолокацию, DNS, WebRTC утечки и уровень доверия систем безопасности к твоему браузеру.
          </p>
        </div>
        <Button href={siteConfig.links.iphey} variant="outline" size="sm" target="_blank" rel="noopener noreferrer" class="self-start">
          Проверить на Iphey →
        </Button>
      </Card>

      <Card class="flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="text-teal-400 font-mono text-xs uppercase tracking-wider">Проверка DNS утечек</div>
          <h3 class="text-xl font-bold text-white">DNSLeakTest.com</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Гарантирует, что твои DNS-запросы идут через шифрованный тоннель VPN, а не через твоего домашнего провайдера.
          </p>
        </div>
        <Button href={siteConfig.links.dnsleaktest} variant="outline" size="sm" target="_blank" rel="noopener noreferrer" class="self-start">
          Проверить DNS →
        </Button>
      </Card>
    </div>
  </div>
</Section>

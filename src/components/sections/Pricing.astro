---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Check from '../ui/Check.astro';
import { siteConfig, getTgLink } from '../../config/site';
---

<Section id="pricing">
  <div class="max-w-7xl mx-auto space-y-12">
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <Badge variant="teal">Тарифы и цены</Badge>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight">
        Честные цены <span class="text-teal-400">без скрытых условий</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg">
        Пробный тариф абсолютно бесплатен и не требует привязки карты. Никаких автосписаний.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {siteConfig.pricing.map((plan) => (
        <Card variant={plan.popular ? 'highlight' : 'default'} class="flex flex-col justify-between space-y-6 relative">
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <Badge variant="teal">Самый популярный</Badge>
            </div>
          )}

          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <h3 class="text-xl font-bold text-white">{plan.name}</h3>
              {plan.badge && !plan.popular && (
                <span class="text-xs text-teal-400 bg-teal-500/10 px-2 py-0.5 rounded font-medium">
                  {plan.badge}
                </span>
              )}
            </div>

            <div class="space-y-1">
              <div class="text-3xl font-extrabold text-white">{plan.price}</div>
              <div class="text-xs text-gray-400">{plan.period} • {plan.duration}</div>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-gray-800/80">
              {plan.features.map((feat) => (
                <li class="flex items-start text-sm text-gray-300">
                  <Check />
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <Button 
            href={getTgLink(`pay_${plan.id}`)} 
            variant={plan.popular ? 'primary' : 'outline'} 
            class="w-full justify-center"
          >
            {plan.id === 'trial' ? 'Взять тест 3 дня' : 'Выбрать тариф'}
          </Button>
        </Card>
      ))}
    </div>
  </div>
</Section>

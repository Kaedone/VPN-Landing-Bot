---
interface Props {
  variant?: 'teal' | 'gray' | 'red';
  class?: string;
}

const { variant = 'teal', class: className = '' } = Astro.props;

const variants = {
  teal: "bg-teal-500/10 text-teal-400 border border-teal-500/20",
  gray: "bg-gray-800 text-gray-300 border border-gray-700",
  red: "bg-red-500/10 text-red-400 border border-red-500/20"
};
---

<span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium tracking-wide ${variants[variant]} ${className}`}>
  <slot />
</span>

---
interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
}

const { id, class: className = '', containerClass = '' } = Astro.props;
---

<section id={id} class={`py-16 md:py-24 relative ${className}`}>
  <div class={`max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${containerClass}`}>
    <slot />
  </div>
</section>

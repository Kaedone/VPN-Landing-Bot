# Server Port
PORT=3000

# AdultVPN Admin Security Configuration
# IMPORTANT FOR PRODUCTION:
# 1. Do NOT commit real secrets or production hashes to Git.
# 2. In Vercel Project Settings -> Environment Variables, configure:
#    - ADMIN_PASSWORD_HASH: Generate with `npm run hash-password` using a strong passphrase (>=16 chars)
#    - SESSION_SECRET: Generate with `openssl rand -hex 32` (at least 32 characters)
#    - POSTGRES_URL: Connection string to your PostgreSQL instance (e.g., Vercel Postgres / Neon / Supabase)
# If ADMIN_PASSWORD_HASH is unset, the server will fail closed (503 Service Unavailable) to protect the admin panel.

ADMIN_PASSWORD_HASH="<REPLACE_WITH_ARGON2ID_PHC_FROM_NPM_RUN_HASH_PASSWORD>"
SESSION_SECRET="<REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET>"

# PostgreSQL Database Connection (Optional in development, required for multi-instance Vercel serverless)
# Supported variables: POSTGRES_URL, DATABASE_URL, or SQL_HOST / SQL_USER / SQL_PASSWORD / SQL_DB_NAME
# POSTGRES_URL="postgres://user:password@ep-your-instance.region.aws.neon.tech/adultvpn?sslmode=require"

# Application Host URL (used for CORS and origin validation)
APP_URL="https://vpn-landing-beige.vercel.app"

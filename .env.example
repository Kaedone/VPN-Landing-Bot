# Server Port
PORT=3000

# AdultVPN Admin Security Configuration
# Generate your production Argon2id hash using: npm run hash-password
# Format: $argon2id$v=19$m=65536,t=3,p=1$<salt_b64>$<hash_b64>
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=1$MTIzNDU2Nzg5MDEyMzQ1Ng$iyiNAlXgzp+3E4Xggb7AWboiOKZML8s4pnhjBb9Uz/I"

# Cryptographic Secret for JWT sessions (minimum 32 characters / 256 bits)
SESSION_SECRET="adultvpn_secure_admin_jwt_session_secret_32_bytes_minimum!"

# Application Host URL
APP_URL="https://vpn-landing-beige.vercel.app"
